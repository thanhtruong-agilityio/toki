{
  "name": "toki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "22.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test && node --test tools/bundle-size/check.test.mjs",
    "build": "pnpm -r --if-present run build",
    "size": "node tools/bundle-size/check.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:up": "bash scripts/up.sh",
    "dev:down": "bash scripts/down.sh",
    "dev:reset": "bash scripts/reset.sh",
    "dev:reset:db": "bash scripts/reset-db.sh",
    "dev:reset:files": "bash scripts/reset-files.sh",
    "dev:reset:mail": "bash scripts/reset-mail.sh",
    "lint": "eslint . --max-warnings 0",
    "test:lint-rules": "node --test tools/lint-rules/icon-only-button-name.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  }
}
