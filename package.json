{
  "name": "toki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": "22.x" },
  "devEngines": {
    "runtime": { "name": "node", "version": "22.x", "onFail": "error" }
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:up": "bash scripts/dev/up.sh",
    "dev:down": "bash scripts/dev/down.sh",
    "dev:reset": "bash scripts/dev/reset.sh",
    "dev:reset:db": "bash scripts/dev/reset-db.sh",
    "dev:reset:files": "bash scripts/dev/reset-files.sh",
    "dev:reset:mail": "bash scripts/dev/reset-mail.sh"
  },
  "devDependencies": { "typescript": "7.0.2" }
}
