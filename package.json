{
  "name": "toki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "22.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck && tsc --noEmit",
    "i18n:check": "pnpm --filter @toki/i18n check",
    "test": "vitest run && node --test tools/bundle-size/check.test.mjs tools/ui-parity/container.test.mjs tools/ui-parity/reference.test.mjs apps/web/scripts/check-no-dev-pages.test.mjs && pnpm run test:lint-rules",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real-server.config.ts --pass-with-no-tests",
    "test:e2e:sign-in": "playwright test -c playwright.sign-in.config.ts",
    "test:e2e:parity": "node tools/ui-parity/container.mjs test",
    "ui:reference": "node tools/ui-parity/container.mjs reference",
    "build": "pnpm -r --if-present run build",
    "size": "node tools/bundle-size/check.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "env:pull": "bash scripts/env-pull.sh",
    "start:local": "bash scripts/start-local.sh",
    "dev:up": "bash scripts/up.sh",
    "dev:down": "bash scripts/down.sh",
    "dev:reset": "bash scripts/reset.sh",
    "dev:reset:db": "bash scripts/reset-db.sh",
    "dev:reset:files": "bash scripts/reset-files.sh",
    "dev:reset:mail": "bash scripts/reset-mail.sh",
    "db:generate": "pnpm --filter @toki/server run db:generate",
    "db:migrate": "pnpm --filter @toki/server run db:migrate",
    "emergency:link": "pnpm --silent --filter @toki/server run emergency:link",
    "lint": "eslint . --max-warnings 0",
    "test:lint-rules": "node --test tools/lint-rules/icon-only-button-name.test.mjs tools/lint-rules/platform-boundary.test.mjs tools/lint-rules/module-entry.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
