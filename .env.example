# Environment variables of Toki, phase 1. The inventory is docs/environment-config.md:
# the two files list the same names. Copy this file to `.env` and fill every empty
# required value with a throwaway local value. Never commit `.env`.

# Server
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
LOG_LEVEL=info

# Database
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_USER=toki
POSTGRES_PASSWORD=
POSTGRES_DB=toki
POSTGRES_TEST_DB=toki_test
POSTGRES_PORT=5432

# File storage (MinIO)
MINIO_ROOT_USER=toki
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=toki-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mail over SMTP (Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=toki@example.com
MAIL_FROM_NAME=Toki
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# First installation
FIRST_ADMIN_EMAIL=admin@example.test
FIRST_ADMIN_NAME=Test Admin
WORKSPACE_NAME=Toki Dev

# Sign-in
AUTH_CODE_SECRET=
APP_ORIGIN=http://localhost:5173
TRUSTED_PROXY=

# Domain
APP_DOMAIN=localhost
